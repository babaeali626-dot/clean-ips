}
.check-label input:checked { background: var(--accent); }
.check-label input:checked::before { transform: translateX(-18px); }

/* Layout Structure */
.app-layout { display: flex; min-height: 100vh; }
aside {
  width: var(--sidebar-w);
  background: #0f172a;
  border-left: 1px solid #1e293b;
  position: fixed;
  top: 0; bottom: 0; right: 0;
  box-shadow: -4px 0 20px rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
}
.brand { padding: 22px 20px; border-bottom: 1px solid #1e293b; }
.brand h1 { font-size: 17px; margin: 0; color: #f8fafc; font-weight: 700; letter-spacing: 0.2px; }
.menu { padding: 16px 10px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
.menu-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 16px;
  border-radius: 9px;
  cursor: pointer;
  color: #94a3b8;
  font-size: 13.5px;
  font-weight: 500;
  transition: all 0.2s ease;
}
.menu-item:hover { background: rgba(255,255,255,0.06); color: #f8fafc; }
.menu-item.active { background: var(--accent); color: #ffffff; font-weight: 600; box-shadow: 0 4px 12px rgba(37,99,235,0.3); }

main { flex: 1; margin-right: var(--sidebar-w); padding: 28px; max-width: 1400px; min-width: 0; }
header.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
header.topbar h2 { margin: 0; font-size: 20px; font-weight: 800; color: #0f172a; }

/* Grid & Dashboard Stats */
.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.stat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
.stat-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.stat-card span { font-size: 12.5px; color: var(--muted); font-weight: 600; }
.stat-card strong { font-size: 24px; color: var(--accent); font-weight: 800; }

.panel-section { display: none; }
.panel-section.active { display: block; animation: fadeIn 0.2s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

/* Table Styles */
.table-wrap { width: 100%; overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; margin-top: 12px; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; text-align: right; background: #fff; }
th, td { padding: 12px 14px; border-bottom: 1px solid var(--border); }
th { color: #475569; font-weight: 700; background: #f8fafc; }
tbody tr:hover { background: #f1f5f9; }

.pill {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  background: #dcfce7;
  color: #15803d;
}
.pill.off { background: #fee2e2; color: #b91c1c; }
.chart-bar { height: 6px; border-radius: 3px; background: var(--accent); display: inline-block; }

.linkrow { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
.linkrow code {
  background: #0f172a;
  color: #93c5fd;
  border: 1px solid #1e293b;
  border-radius: 9px;
  padding: 12px;
  direction: ltr;
  text-align: left;
  font-size: 12.5px;
  word-break: break-all;
  user-select: all;
}

/* Toast Notifications */
.status-msg {
  position: fixed;
  bottom: 24px;
  left: 24px;
  z-index: 9999;
  padding: 14px 20px;
  border-radius: 10px;
  font-size: 13.5px;
  font-weight: 600;
  background: #064e3b;
  color: #a7f3d0;
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  gap: 10px;
  animation: slideIn 0.25s ease;
}
.status-msg.error { background: #7f1d1d; color: #fecaca; }
@keyframes slideIn { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.small-note { font-size: 12px; color: var(--muted); line-height: 1.6; margin-top: 4px; }

/* Responsive protocol forms, port chips, and accessible horizontal navigation */
.port-manager { border: 1px solid var(--border); border-radius: 12px; padding: 12px; margin-top: 12px; background: #f8fafc; min-width: 0; }
.port-manager h3 { margin: 0 0 8px; font-size: 13px; }
.port-add-row { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 8px; align-items: center; }
.port-add-row input { width: 100%; min-width: 0; background: #fff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 11px 14px; color: #1e293b; font-size: 14px; direction: ltr; text-align: left; }
.port-add-row input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(37,99,235,.15); }
.port-chip-list { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 9px; }
.port-chip { display: inline-flex; align-items: center; gap: 8px; border: 1px solid #bfdbfe; border-radius: 999px; padding: 5px 9px; background: #eff6ff; color: #1d4ed8; font-size: 12px; direction: ltr; }
.port-chip button { padding: 2px 7px; min-width: 24px; border-radius: 999px; box-shadow: none; font-size: 12px; background: #dbeafe; color: #1e40af; }
.direct-uri-list { display: grid; gap: 10px; }
.direct-uri-item { border: 1px solid var(--border); border-radius: 11px; padding: 12px; min-width: 0; background: #fff; }
.direct-uri-item .uri-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap; margin-bottom:8px; font-weight:700; font-size:13px; }
.direct-uri-item code { display:block; max-width:100%; overflow-wrap:anywhere; direction:ltr; text-align:left; background:#0f172a; color:#bfdbfe; padding:10px; border-radius:8px; font-size:12px; }
.config-pill-row { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid rgba(37,99,235,.3); outline-offset: 2px; }
[dir="rtl"] th, [dir="rtl"] td { text-align: right; }
@media(max-width: 900px) {
  .app-layout { display: block; }
  aside { position: sticky; top: 0; z-index: 50; width: 100%; height: auto; inset: auto; border-left: 0; border-bottom: 1px solid #1e293b; box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  .brand { padding: 12px 16px; }
  .brand h1 { display: block !important; font-size: 15px; }
  .menu { padding: 8px; flex-direction: row; overflow-x: auto; gap: 6px; }
  aside .menu-item { justify-content: center; padding: 10px 13px; white-space: nowrap; flex: 0 0 auto; }
  aside .menu-item span { display: inline !important; }
  main { margin: 0; padding: 18px; max-width: none; }
  .grid-2 { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .stat-grid { grid-template-columns: repeat(3, minmax(0,1fr)); }
}
@media(max-width: 620px) {
  main { padding: 12px; }
