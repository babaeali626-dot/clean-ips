  const segments = url.pathname.split("/").filter(Boolean);
  if (segments.length !== 3 || segments[0] !== "sub") return new Response("Not found", { status: 404 });
  const settings = await loadSettings(kv, env);
  if (!segments[1] || !constantTimeEqual(segments[1], settings.subToken)) return new Response("Not found", { status: 404 });
  const host = cleanHost(settings.publicHost) || url.hostname;

  if (segments[2] === "xray") {
    const uris = makeUris(settings, host);
    if (!uris.length) return new Response("No config", { status: 404 });
    return new Response(base64Utf8(uris.join("\n")), { headers: securityHeaders({
      "content-type": "text/plain; charset=utf-8", "cache-control": "no-store",
      "profile-title": settings.username + " Subscription"
    }) });
  }
  if (segments[2] === "singbox") {
    const config = makeSingBoxConfig(settings, host);
    return new Response(JSON.stringify(config, null, 2), { headers: securityHeaders({
      "content-type": "application/json; charset=utf-8", "cache-control": "no-store",
      "content-disposition": "attachment; filename=" + settings.username + "-sing-box.json"
    }) });
  }
  if (segments[2] === "xray-json") {
    const config = makeXrayConfig(settings, host);
    return new Response(JSON.stringify(config, null, 2), { headers: securityHeaders({
      "content-type": "application/json; charset=utf-8", "cache-control": "no-store",
      "content-disposition": "attachment; filename=" + settings.username + "-xray.json"
    }) });
  }
  return new Response("Not found", { status: 404 });
}

function makeSubscriptionLinks(settings, requestUrl, host) {
  const origin = requestUrl.origin;
  const token = encodeURIComponent(settings.subToken || "");
  return {
    xray: origin + "/sub/" + token + "/xray",
    singbox: origin + "/sub/" + token + "/singbox",
    xrayJson: origin + "/sub/" + token + "/xray-json",
    uris: makeUris(settings, host)
  };
}

function makeUris(settings, host) {
  const result = [];
  const publicHost = cleanHost(host);
  const edPart = settings.earlyData ? "?ed=" + EARLY_DATA_SIZE : "";
  const pathOf = base => encodeURIComponent(base + edPart);
  const echExtra = settings.echEnabled ? "&ech=" + encodeURIComponent(publicHost + "+" + (settings.remoteDns || DEFAULT_REMOTE_DNS)) : "";
  const tlsExtra = "&fp=chrome&alpn=" + encodeURIComponent("http/1.1") + echExtra;
  const pass = settings.trojanPassword ? encodeURIComponent(settings.trojanPassword) : "";
  
  const endpoints = getEndpoints(settings, publicHost);
  const outbounds = generateOutboundsData(settings, endpoints);

  for (const o of outbounds) {
    const addr = uriHost(o.address);
    // encodeURIComponent is applied to the ENTIRE tag uniformly
    const safeTagStr = encodeURIComponent(o.tag);
    if (o.proto === "VLESS") {
      if (o.isTls) result.push(`vless://${settings.uuid}@${addr}:${o.port}?encryption=none&security=tls&type=ws&host=${encodeURIComponent(publicHost)}&sni=${encodeURIComponent(publicHost)}${tlsExtra}&path=${pathOf("/vless")}#${safeTagStr}`);
      else result.push(`vless://${settings.uuid}@${addr}:${o.port}?encryption=none&security=none&type=ws&host=${encodeURIComponent(publicHost)}&path=${pathOf("/vless")}#${safeTagStr}`);
    } else if (o.proto === "Trojan") {
      if (o.isTls) result.push(`trojan://${pass}@${addr}:${o.port}?security=tls&type=ws&host=${encodeURIComponent(publicHost)}&sni=${encodeURIComponent(publicHost)}${tlsExtra}&path=${pathOf("/trojan")}#${safeTagStr}`);
      else result.push(`trojan://${pass}@${addr}:${o.port}?security=none&type=ws&host=${encodeURIComponent(publicHost)}&path=${pathOf("/trojan")}#${safeTagStr}`);
    }
  }
  return result;
}

function makeXrayConfig(settings, host) {
  const sni = cleanHost(host);
  const endpoints = getEndpoints(settings, sni);
  const early = settings.earlyData ? "?ed=" + EARLY_DATA_SIZE : "";
  
  const outboundsData = generateOutboundsData(settings, endpoints);
  const proxies = [];

  for (const o of outboundsData) {
    const stream = {
      network: "ws", security: o.isTls ? "tls" : "none",
      wsSettings: { path: `/${o.proto.toLowerCase()}${early}`, headers: { Host: sni } }
    };
    if (o.isTls) {
      stream.tlsSettings = { serverName: sni, allowInsecure: false, fingerprint: "chrome", alpn: ["http/1.1"] };
      if (settings.echEnabled) stream.tlsSettings.echConfigList = `${sni}+${settings.remoteDns || DEFAULT_REMOTE_DNS}`;
    }
    if (settings.fragmentEnabled && o.isTls) stream.sockopt = { dialerProxy: "fragment" };

    if (o.proto === "VLESS") {
      proxies.push({ tag: o.tag, protocol: "vless", settings: { vnext: [{ address: o.address, port: o.port, users: [{ id: settings.uuid, encryption: "none" }] }] }, streamSettings: stream });
    } else {
      proxies.push({ tag: o.tag, protocol: "trojan", settings: { servers: [{ address: o.address, port: o.port, password: settings.trojanPassword }] }, streamSettings: stream });
    }
  }

  const bypass = settings.bypassIran === true;
  const rules = [];
  if (bypass) {
    rules.push({ type: "field", ip: ["geoip:private"], outboundTag: "direct" });
    rules.push({ type: "field", domain: ["geosite:ir", "regexp:.*\\.ir$"], outboundTag: "direct" });
    rules.push({ type: "field", ip: ["geoip:ir"], outboundTag: "direct" });
  }
  const customBypass = parseCustomBypass(settings.customBypass);
  const customDomains = customBypass.filter(x => x.type === "domain").map(x => "domain:" + x.value);
  const customIps = customBypass.filter(x => x.type === "ip").map(x => x.value);
  if (customDomains.length) rules.push({ type: "field", domain: customDomains, outboundTag: "direct" });
  if (customIps.length) rules.push({ type: "field", ip: customIps, outboundTag: "direct" });

  rules.push({ type: "field", network: "udp", port: "53", outboundTag: "direct" });
  rules.push({ type: "field", network: "udp", outboundTag: "block" });

  const routing = { domainStrategy: bypass ? "IPIfNonMatch" : "AsIs", rules };
  const outbounds = [
    ...proxies,
    { tag: "direct", protocol: "freedom", settings: {} },
    { tag: "block", protocol: "blackhole", settings: { response: { type: "http" } } }
  ];

  if (settings.fragmentEnabled && proxies.some(p => p.streamSettings.security === "tls")) {
    outbounds.push({ tag: "fragment", protocol: "freedom", settings: { fragment: { packets: "tlshello", length: settings.fragmentLength || "100-200", interval: settings.fragmentInterval || "10-20" } } });
  }

  const config = {
    log: { loglevel: normalizeLogLevel(settings.logLevel) },
    dns: { servers: buildXrayDnsServers(settings), queryStrategy: settings.ipv6Enabled === false ? "UseIPv4" : "UseIP" },
    inbounds: [{ tag: "socks-in", listen: "127.0.0.1", port: 10808, protocol: "socks", settings: { auth: "noauth", udp: true }, sniffing: { enabled: true, destOverride: settings.fakeDnsEnabled ? ["http", "tls", "quic", "fakedns"] : ["http", "tls"] } }],
    outbounds, routing
  };
  if (settings.fakeDnsEnabled) {
    config.fakedns = settings.ipv6Enabled === false
      ? { ipPool: "198.18.0.0/15", poolSize: 65535 }
      : [{ ipPool: "198.18.0.0/15", poolSize: 32768 }, { ipPool: "fc00::/18", poolSize: 32768 }];
  }

  if (proxies.length > 1) {
    routing.balancers = [{ tag: "proxy-balancer", selector: [settings.username + " config"], strategy: { type: "leastPing" } }];
    rules.push({ type: "field", network: "tcp", balancerTag: "proxy-balancer" });
    config.observatory = { subjectSelector: [settings.username + " config"], probeUrl: "https://www.gstatic.com/generate_204", probeInterval: "3m" };
  } else if (proxies.length === 1) {
    rules.push({ type: "field", network: "tcp", outboundTag: proxies[0].tag });
  }
  return config;
}

function makeSingBoxConfig(settings, host) {
  const sni = cleanHost(host);
  const endpoints = getEndpoints(settings, sni);
  const outboundsData = generateOutboundsData(settings, endpoints);
  const outbounds = [];
  const tags = [];
  
  const tlsCfg = (isTls) => {
    if (!isTls) return { enabled: false };
    const config = {
      enabled: true, server_name: sni, insecure: false,
      fragment: settings.fragmentEnabled,
      fragment_length: settings.fragmentEnabled ? settings.fragmentLength : undefined,
      fragment_interval: settings.fragmentEnabled ? settings.fragmentInterval : undefined,
      fragment_fallback_delay: "500ms"
    };
    if (settings.echEnabled) config.ech = { enabled: true };
    return config;
  };

  const transport = path => {
    const t = { type: "ws", path, headers: { Host: sni } };
    if (settings.earlyData) { t.max_early_data = EARLY_DATA_SIZE; t.early_data_header_name = "Sec-WebSocket-Protocol"; }
    return t;
  };

  for (const o of outboundsData) {
    tags.push(o.tag);
    if (o.proto === "VLESS") {
      outbounds.push({ type: "vless", tag: o.tag, server: o.address, server_port: o.port, uuid: settings.uuid, tls: tlsCfg(o.isTls), transport: transport("/vless") });
    } else {
      outbounds.push({ type: "trojan", tag: o.tag, server: o.address, server_port: o.port, password: settings.trojanPassword, tls: tlsCfg(o.isTls), transport: transport("/trojan") });
    }
  }

  if (tags.length > 0) {
    outbounds.push({ type: "urltest", tag: "best-ping", outbounds: tags, url: "https://www.gstatic.com/generate_204", interval: "3m", tolerance: 50 });
    outbounds.push({ type: "selector", tag: "proxy", outbounds: ["best-ping", ...tags], default: "best-ping" });
  }
  outbounds.push({ type: "direct", tag: "direct" });
  outbounds.push({ type: "block", tag: "block" });

  const routeRules = [];
  if (settings.bypassIran === true) routeRules.push({ ip_is_private: true, outbound: "direct" }, { domain_suffix: [".ir"], outbound: "direct" });
  const customBypass = parseCustomBypass(settings.customBypass);
  const customDomains = customBypass.filter(x => x.type === "domain").map(x => x.value);
  const customIps = customBypass.filter(x => x.type === "ip").map(x => x.value);
  if (customDomains.length) routeRules.push({ domain_suffix: customDomains, outbound: "direct" });
  if (customIps.length) routeRules.push({ ip_cidr: customIps, outbound: "direct" });
  routeRules.push({ network: ["udp"], port: [53], outbound: "direct" });
  routeRules.push({ network: ["udp"], outbound: "block" });

  const dnsServers = [toSingBoxDnsServer(settings.localDns || "localhost", "local"), toSingBoxDnsServer(settings.remoteDns || DEFAULT_REMOTE_DNS, "remote")];
  if (settings.antiSanctionDns) dnsServers.push(toSingBoxDnsServer(settings.antiSanctionDns, "anti-sanction"));
  if (settings.fakeDnsEnabled) dnsServers.push({ type: "fakeip", tag: "fakeip", inet4_range: "198.18.0.0/15", ...(settings.ipv6Enabled === false ? {} : { inet6_range: "fc00::/18" }) });
  const dnsRules = [];
  if (settings.bypassIran) dnsRules.push({ domain_suffix: [".ir"], server: "local" });
  const dnsFinal = settings.fakeDnsEnabled ? "fakeip" : (settings.antiSanctionDns ? "anti-sanction" : "remote");

  return {
    log: { level: logLevelForSingBox(settings.logLevel), timestamp: true, ...(normalizeLogLevel(settings.logLevel) === "none" ? { disabled: true } : {}) },
    dns: { servers: dnsServers, ...(dnsRules.length ? { rules: dnsRules } : {}), final: dnsFinal, strategy: settings.ipv6Enabled === false ? "ipv4_only" : "prefer_ipv4" },
    inbounds: [{ type: "mixed", tag: "mixed-in", listen: "127.0.0.1", listen_port: 2080 }],
    outbounds, route: { final: tags.length ? "proxy" : "direct", auto_detect_interface: true, rules: routeRules }
  };
}

function uriHost(host) { return host.includes(":") && !host.startsWith("[") ? "[" + host + "]" : host; }
function cleanHost(value) { return String(value || "").trim().replace(/^\[|\]$/g, ""); }

// -------------------- Tunnel Handling --------------------

async function handleTunnel(request, env, kv, kind) {
  if (request.headers.get("Upgrade")?.toLowerCase() !== "websocket") return fakeLandingResponse();
  const settings = await loadSettings(kv, env);
  if (kind === "vless" && (!settings.vlessEnabled || !settings.uuid)) return new Response("VLESS disabled", { status: 404 });
  if (kind === "trojan" && (!settings.trojanEnabled || !settings.trojanPassword)) return new Response("Trojan disabled", { status: 404 });

  const earlyDataHeader = settings.earlyData ? request.headers.get("sec-websocket-protocol") : null;
  const earlyBytes = decodeEarlyData(earlyDataHeader);
  // Xray Browser Dialer compatibility: echo only the valid, unpadded base64url
  // token used for early data. Do not reflect arbitrary/comma-separated headers.
  const earlyDataProtocol = getEarlyDataProtocolForResponse(earlyDataHeader, earlyBytes);

  const pair = new WebSocketPair();
  const client = pair[0], server = pair[1];
  server.accept({ allowHalfOpen: true });

  let initialized = false, finished = false, inboundQueue = Promise.resolve();
  let udp = null, dest = null, remote = null, remoteWriter = null, generation = 0;
  let receivedAny = false, fallbackTried = false, switching = null;
  let initialWritesBuffer = [], initialWritesSize = 0, bufferOverflow = false;

  const closeAll = () => {
    if (finished) return; finished = true;
    try { server.close(); } catch {} try { if (remoteWriter) remoteWriter.close().catch(()=>{}); } catch {} try { if (remote && remote.close) remote.close(); } catch {}
    initialWritesBuffer = [];
  };

  const rememberWrite = bytes => {
    if (receivedAny || bufferOverflow || !bytes || !bytes.length) return;
    if (initialWritesSize + bytes.length > MAX_INITIAL_BUFFER) { bufferOverflow = true; initialWritesBuffer = []; initialWritesSize = 0; return; }
    initialWritesBuffer.push(bytes); initialWritesSize += bytes.length;
  };

  const canFallback = () => !finished && !!dest && !receivedAny && !fallbackTried && !bufferOverflow && !settings.chainProxy && !!settings.proxyIP;

  const startFallback = () => {
    if (switching) return switching;
    if (!canFallback()) return Promise.resolve(false);
    fallbackTried = true;
    const job = (async () => {
      let next = null;
      try {
        const sentCount = initialWritesBuffer.length;
        next = await openOutbound(settings, dest.host, dest.port, concatChunks(initialWritesBuffer), true);
        if (finished) { try { next.close(); } catch {} return false; }
        const nextWriter = next.writable.getWriter();
        for (let i = sentCount; i < initialWritesBuffer.length; i++) {
          if (bufferOverflow) throw new Error("overflow");
          await nextWriter.write(initialWritesBuffer[i]);
        }
        const prev = remote, prevWriter = remoteWriter;
        remote = next; remoteWriter = nextWriter; switching = null; generation++;
        try { if (prevWriter) prevWriter.close().catch(()=>{}); } catch {} try { if (prev && prev.close) prev.close(); } catch {}
        void pumpRemote(next.readable, server, hooks, generation);
        return true;
      } catch (err) { try { if (next && next.close) next.close(); } catch {} return false; }
    })();
    switching = job; job.finally(() => { if (switching === job) switching = null; });
    return job;
  };

  const hooks = { isStale: gen => gen !== generation, onFirstByte: () => { receivedAny = true; initialWritesBuffer = []; initialWritesSize = 0; }, fallback: async gen => (gen !== generation) || (await startFallback()), closeAll };

  const writeRemote = async bytes => {
    rememberWrite(bytes);
    if (switching) { await switching; return; }
    try { await remoteWriter.write(bytes); } catch (err) { if (canFallback() && await startFallback()) return; throw err; }
  };

  const startTcp = async parsed => {
    if (!isAllowedDestinationPort(parsed.port, env)) throw new Error("port not allowed");
    dest = { host: parsed.host, port: parsed.port }; rememberWrite(parsed.data);
    const r = await openOutbound(settings, parsed.host, parsed.port, parsed.data, false);
    if (finished) { try { r.close(); } catch {} return; }
    if (r.viaProxyIP) fallbackTried = true;
    remote = r; remoteWriter = r.writable.getWriter();
    if (kind === "vless") server.send(new Uint8Array([parsed.version, 0]));
    generation++; void pumpRemote(r.readable, server, hooks, generation);
  };

  const startUdp = parsed => {
    udp = {
      mode: kind,
      pending: new Uint8Array(0),
      header: kind === "vless" ? new Uint8Array([parsed.version, 0]) : null,
      inflight: 0
    };
    if (parsed.data.length) {
      if (kind === "trojan") handleTrojanUdpDnsPackets(parsed.data, udp, settings.dohUrl, server);
      else handleUdpDnsPackets(parsed.data, udp, settings.dohUrl, server);
    }
  };

  const processInbound = async bytes => {
    if (finished) return;
    if (!initialized) {
      initialized = true;
      let parsed = kind === "vless" ? parseVlessRequest(bytes, settings.uuid) : parseTrojanRequest(bytes, settings.trojanPassword);
      if (parsed.udp) startUdp(parsed); else await startTcp(parsed);
    } else if (udp) {
      if (udp.mode === "trojan") handleTrojanUdpDnsPackets(bytes, udp, settings.dohUrl, server);
      else handleUdpDnsPackets(bytes, udp, settings.dohUrl, server);
    } else { if (!remoteWriter) throw new Error("not ready"); await writeRemote(bytes); }
  };

  if (earlyBytes && earlyBytes.length) inboundQueue = inboundQueue.then(() => processInbound(earlyBytes)).catch(closeAll);
  server.addEventListener("message", ev => { inboundQueue = inboundQueue.then(async () => { if (!finished) await processInbound(await toBytes(ev.data)); }).catch(closeAll); });
  server.addEventListener("close", () => closeAll());
  server.addEventListener("error", () => closeAll());
  return new Response(null, {
    status: 101,
    webSocket: client,
    ...(earlyDataProtocol ? { headers: { "Sec-WebSocket-Protocol": earlyDataProtocol } } : {})
  });
}

function getEarlyDataProtocolForResponse(header, earlyBytes) {
  if (!header || !earlyBytes || !earlyBytes.length || earlyBytes.length > EARLY_DATA_SIZE) return null;
  const value = String(header).trim();
  // RFC 6455 subprotocol values must be tokens; base64url without padding is safe.
  if (value.length > MAX_EARLY_HEADER || !/^[A-Za-z0-9_-]+$/.test(value)) return null;
  return value;
}

function decodeEarlyData(header) {
  if (!header || header.length > MAX_EARLY_HEADER) return null;
  const token = header.split(",")[0].trim();
  if (!token || !/^[A-Za-z0-9_-]+={0,2}$/.test(token)) return null;
  try {
    const b64 = token.replace(/=+$/, "").replace(/-/g, "+").replace(/_/g, "/");
    const bin = atob(b64 + "=".repeat((4 - (b64.length % 4)) % 4));
    const out = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out.length ? out : null;
  } catch { return null; }
}

function concatChunks(chunks) {
  const out = new Uint8Array(chunks.reduce((s, c) => s + c.length, 0));
  let p = 0; for (const c of chunks) { out.set(c, p); p += c.length; }
  return out;
}

async function pumpRemote(readable, ws, hooks, gen) {
  let receivedAny = false;
  try {
    const reader = readable.getReader();
    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      if (!value || !value.byteLength) continue;
      if (hooks.isStale(gen)) return;
      if (!receivedAny) { receivedAny = true; hooks.onFirstByte(); }
      if (ws.readyState !== WebSocket.OPEN) break;
      ws.send(value);
    }
  } catch {}
  if (!receivedAny) { let rec = false; try { rec = await hooks.fallback(gen); } catch {} if (rec) return; }
  if (hooks.isStale(gen)) return;
  hooks.closeAll();
}

async function openOutbound(settings, host, port, initialData, forceProxyIP = false) {
  if (settings.chainProxy) return await openChainedWebSocket(settings.chainProxy, host, port, initialData);
  const viaProxyIP = async () => { const target = parseHostPort(settings.proxyIP, port); const tunnel = await openDirect(target.host, target.port, initialData); return { ...tunnel, viaProxyIP: true }; };
  if (forceProxyIP && settings.proxyIP) return await viaProxyIP();
  try { return await openDirect(host, port, initialData); } catch (err) { if (!settings.proxyIP) throw err; return await viaProxyIP(); }
}

async function openDirect(host, port, initialData) {
  const socket = connect({ hostname: host, port }, { secureTransport: "off", allowHalfOpen: true });
  const close = () => { try { Promise.resolve(socket.close()).catch(()=>{}); } catch {} };
  try {
    let timer; const timeout = new Promise((_, r) => { timer = setTimeout(() => r(new Error("timeout")), 10000); });
    try { await Promise.race([socket.opened, timeout]); } finally { clearTimeout(timer); }
    if (initialData && initialData.length) { const w = socket.writable.getWriter(); try { await w.write(initialData); } finally { w.releaseLock(); } }
  } catch (err) { close(); throw err; }
  return { readable: socket.readable, writable: socket.writable, close };
}

function handleUdpDnsPackets(chunk, state, dohUrl, ws) {
  state.pending = concatBytes(state.pending, chunk);
  while (state.pending.length >= 2) {
    const len = (state.pending[0] << 8) | state.pending[1];
    if (state.pending.length < 2 + len) break;
    const packet = state.pending.slice(2, 2 + len); state.pending = state.pending.slice(2 + len);
    if (!len) continue;
    if (state.inflight >= UDP_MAX_INFLIGHT) continue;
    state.inflight++;
    forwardDnsQuery(packet, state, dohUrl, ws).catch(()=>{}).finally(() => { state.inflight--; });
  }
}

// Trojan UDP datagrams carry an address and port for every packet. This implementation
// intentionally supports DNS (destination port 53) via the configured DoH resolver only.
function handleTrojanUdpDnsPackets(chunk, state, dohUrl, ws) {
  if (state.pending.length + chunk.length > 262144) throw new Error("Trojan UDP buffer limit exceeded");
  state.pending = concatBytes(state.pending, chunk);
  while (state.pending.length) {
    const data = state.pending;
    const type = data[0];
    let addressMinimum;
    if (type === 1) addressMinimum = 5;
    else if (type === 3) {
      if (data.length < 2) break;
      if (!data[1]) throw new Error("invalid Trojan UDP domain length");
      addressMinimum = 2 + data[1];
    } else if (type === 4) addressMinimum = 17;
    else throw new Error("invalid Trojan UDP address type");
    if (data.length < addressMinimum) break;

    const address = parseTrojanAddress(data, 0);
    const p = address.next;
    if (data.length < p + 6) break;
    const port = (data[p] << 8) | data[p + 1];
    const len = (data[p + 2] << 8) | data[p + 3];
    if (data[p + 4] !== 13 || data[p + 5] !== 10) throw new Error("invalid Trojan UDP CRLF");
    const total = p + 6 + len;
    if (data.length < total) break;
    const packet = data.slice(p + 6, total);
    state.pending = data.slice(total);
    if (!packet.length) continue;
    if (port !== 53) throw new Error("Trojan UDP only supports DNS on port 53");
    if (state.inflight >= UDP_MAX_INFLIGHT) continue;
    state.inflight++;
    forwardDnsQuery(packet, state, dohUrl, ws, { host: address.host, port }).catch(()=>{}).finally(() => { state.inflight--; });
  }
}

function encodeTrojanUdpPacket(host, port, payload) {
  let address;
  if (isIPv4Text(host)) {
    address = new Uint8Array([1, ...host.split(".").map(Number)]);
  } else if (isIPv6Text(host)) {
    const groups = expandIPv6(host), raw = new Uint8Array(17);
    raw[0] = 4;
    for (let i = 0; i < groups.length; i++) { raw[1 + i * 2] = (groups[i] >> 8) & 255; raw[2 + i * 2] = groups[i] & 255; }
    address = raw;
  } else {
    const bytes = enc.encode(String(host));
    if (!bytes.length || bytes.length > 255) throw new Error("invalid Trojan UDP response host");
    address = new Uint8Array(2 + bytes.length); address[0] = 3; address[1] = bytes.length; address.set(bytes, 2);
  }
  if (!Number.isInteger(port) || port < 1 || port > 65535 || !payload.length || payload.length > 65535) throw new Error("invalid Trojan UDP response");
  const out = new Uint8Array(address.length + 6 + payload.length);
  out.set(address, 0);
  const p = address.length;
