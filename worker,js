  header.topbar h2 { font-size: 17px; }
  .topbar { gap: 10px; }
  .port-add-row { grid-template-columns: minmax(0,1fr); }
  .status-msg { left: 12px; right: 12px; bottom: 12px; }
  .auth-wrapper { margin: 5vh auto; padding: 12px; }
  .field-grid, .protocol-pair-grid, .bypass-builder { grid-template-columns: minmax(0,1fr) !important; }
  th, td { padding: 9px 10px; }
}
@media(max-width: 420px) { .uri-heading button, .bypass-builder button { width: 100%; } .bypass-builder .field { margin-bottom: 8px; } }
@media(prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; } }

