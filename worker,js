.random-clean-tools { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12px; padding: 16px; margin: 16px 0; border: 1px solid var(--border); border-radius: 16px; background: rgba(15,21,53,0.6); }
