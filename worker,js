let formExtraTlsPorts = [];
let formExtraNonTlsPorts = [];
const externalPingResults = Object.create(null);
const portKey = (host, port) => String(host || '').replace(/^\[|\]$/g, '').toLowerCase() + '|' + Number(port);

const ERROR_DICT = {
  "ERR_AUTH_FAILED": { msg: "نام کاربری یا رمز عبور اشتباه است.", action: "دوباره تلاش کنید." },
